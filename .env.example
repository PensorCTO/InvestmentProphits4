POLYGON_RPC_URLS=https://polygon-rpc.com
ALCHEMY_API_KEY=
POLYGON_RPC_PRIMARY=
POLYGON_RPC_FALLBACK_URLS=https://polygon-rpc.com,https://rpc.ankr.com/polygon,https://polygon.llamarpc.com,https://polygon-bor-rpc.publicnode.com
POLYGON_WALLET_PRIVATE_KEY=
# Required for LIVE mode — without this, dashboard Switch to Live stays stuck at LIVE_PENDING
POLYGON_WALLET_ADDRESS=
EXECUTION_GAS_LIMIT=300000
GAS_SPIKE_VETO_FRACTION=0.05
MATIC_USD_PRICE=0.45
LIVE_EXEC_TIMEOUT_SECONDS=30
PREFLIGHT_MAX_RPC_LATENCY_MS=50
# Escape hatch for offline dev only:
# PREFLIGHT_SKIP_LATENCY=true
EMBEDDING_DIMS=1024
# false = real Polymarket CLOB books + live overlay feeds (recommended)
# true  = synthetic OBI/depth/overlays for offline paper dev only
EDGE_MODEL_MOCKED=false
LONGSHOT_ONLY=false
CROSS_VENUE_ENABLED=false
# When Kalshi has no match, derive bounded cross_venue from OBI sign (consensus strategies)
CROSS_VENUE_OBI_PROXY=true
MAX_SWARM_MARKET_EXPOSURE=2500
# NAV fraction for swarm herding cap (defaults to APEX_MAX_POSITION_PCT); cap = max(floor, NAV × pct)
SWARM_HERDING_NAV_PCT=
ORACLE_SYNC_INTERVAL=30
APEX_EXEC_INTERVAL=10
ARENA_HEARTBEAT_INTERVAL=600
ARENA_RISK_INTERVAL=45
ORACLE_STALE_SECONDS=60
# Oracle circuit breaker — trips DRAIN_AND_HALT after N consecutive ingest failures
ORACLE_CB_ENABLED=true
ORACLE_CB_FAILURE_THRESHOLD=3
ORACLE_CB_RECOVERY_SECONDS=120
# Live post-KEEP audit — auto-revert Turso champion on slope breach (shadow mode logs only)
LIVE_AUDIT_ENABLED=true
LIVE_AUDIT_SHADOW=true
LIVE_AUDIT_MIN_CLOSES=5
HMM_ENABLED=true
HMM_STATE_PERSIST_TICKS=2
HMM_MEAN_REVERT_MIN_NET_EDGE=0.012
HMM_MEAN_REVERT_OBI_WEIGHT=0.28
HMM_TOXIC_MAX_FRACTIONAL_KELLY=0.025
HMM_TOXIC_MAX_PORTFOLIO_PCT=0.20
# Adversarial text filter max input length
ADVERSARIAL_MAX_TEXT_LENGTH=32000
# Toxicity gate fail-closed when corpus/Ollama unavailable
TOXICITY_FAIL_CLOSED=false
ORACLE_HTTP_TIMEOUT_SECONDS=15
ORACLE_MAX_CONCURRENT=20
REPLICA_SYNC_DEBOUNCE_SECONDS=2
SNAPSHOT_ARCHIVE_EVERY_N=10
POLYMARKET_CLOB_BASE=https://clob.polymarket.com
POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
GAMMA_REQUEST_DELAY_SECONDS=0.35
GAMMA_MARKET_MAP_PATH=data/gamma_market_map.json
TIER_HIGH_VOLUME=10000000
TIER_MED_VOLUME=1000000
COMMITTEE_TOXICITY_VETO_THRESHOLD=0.75
COMMITTEE_ENABLED=false
NEWS_API_KEY=
CROSS_VENUE_API_KEY=
EMBED_TIMEOUT_SECONDS=30
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_URL=http://localhost:11434/api/embed
EMBEDDING_MODEL=hf.co/Qwen/Qwen3-Embedding-0.6B-GGUF:F16
EMBEDDING_QUERY_INSTRUCT="Given a paper trade entry context, retrieve similar historical trade setups"
# Legacy fallback; authoritative mode is execution_controls.active_execution_mode in Turso
EXECUTION_MODE=paper
IP4_DASHBOARD_PORT=8501
SUPERVISOR_POLL_SECONDS=3
APEX_AGENT_ID=APEX_EDGE
APEX_INITIAL_CAPITAL=100.0
# Optional NAV floor — inject capital when NAV drops below this value (empty = disabled)
# APEX_BANKRUPTCY_FLOOR=20.0
APEX_FRACTIONAL_KELLY=0.05
# Max fraction of NAV per market (ladder cap per market)
APEX_MAX_POSITION_PCT=0.05
APEX_LIQUIDITY_FLOOR=50000
APEX_MIN_NET_EDGE=0.015
# Deprecated — paper uses APEX_MIN_NET_EDGE unless APEX_EDGE_MODE=exploration
APEX_PAPER_MIN_NET_EDGE=0.015
APEX_EXPLORATION_MIN_NET_EDGE=0.008
# Set to "exploration" for research paper runs only (uses APEX_EXPLORATION_MIN_NET_EDGE)
APEX_EDGE_MODE=
CRUCIBLE_EXPLORATION=false
MOCK_OBI_FAIR_WEIGHT=0.30
MOCK_OBI_FAIR_FLOOR=0.025
# OBI-implied fair bump weight for strategy-aligned execution (default 0.08)
OBI_FAIR_WEIGHT=0.08
# Minimum fair bump on sub-10% mid longshot markets (absolute cap; see OBI_FAIR_FLOOR_RATIO)
OBI_FAIR_FLOOR=0.012
OBI_FAIR_FLOOR_RATIO=0.35
APEX_MIN_LADDER_USD=5.0
# Max concurrent open legs portfolio-wide (default 3; use 6 for six single-leg markets)
APEX_MAX_LADDER_LEGS=6
# Per-market leg cap (default floor(APEX_MAX_LADDER_LEGS/2)); override explicitly if needed
APEX_MAX_LEGS_PER_MARKET=1
# Ticks at max_legs block before idle/cap-stall rotation (18 ≈ 3 min at 10s ticks)
APEX_CAP_STALL_REMEDIATE_TICKS=18
# Minimum open legs before FULLY_DEPLOYED / idle rotation (default 67% of APEX_MAX_LADDER_LEGS)
APEX_FULLY_DEPLOYED_ROTATE_MIN_FRACTION=0.67
# Override min open legs explicitly (optional; e.g. 4 when APEX_MAX_LADDER_LEGS=6)
# APEX_FULLY_DEPLOYED_ROTATE_MIN_OPEN_LEGS=4
# Block same-direction refill after FULLY_DEPLOYED_ROTATE until thesis moves materially
APEX_ROTATE_REENTRY_MID_DELTA=0.02
APEX_ROTATE_REENTRY_FV_DELTA=0.02
APEX_ROTATE_REENTRY_BLOCK_SECONDS=3600
V2_MIN_NET_EDGE_COST_MULT=1.0
# Close open legs when strategy returns HOLD on that market
APEX_CLOSE_ON_HOLD=true
# Consecutive HOLD ticks before thesis-expired close (default 3)
APEX_HOLD_CLOSE_TICKS=3
# Minimum seconds to hold before thesis-expired close
APEX_MIN_HOLD_SECONDS=60
# Block re-entry after THESIS_EXPIRED close (default 900s — stops buy/HOLD/close loops)
APEX_THESIS_REENTRY_COOLDOWN_SECONDS=900
# Cooldown after remediate close before re-entry on same market (seconds)
APEX_REMEDIATE_COOLDOWN_SECONDS=120
# Cap-rebalance churn guard — pause trim/refill when spread-tax loop detected
APEX_CAP_CHURN_GUARD=true
APEX_CAP_CHURN_WINDOW_TICKS=6
APEX_CAP_CHURN_MIN_SAME_TICK_EVENTS=2
APEX_CAP_CHURN_COOLDOWN_SECONDS=600
APEX_CAP_CHURN_NAV_DRAWDOWN_PCT=0.12
APEX_CAP_CHURN_ROTATE_FILL_WINDOW_SECONDS=180
APEX_CAP_CHURN_MIN_ROTATE_FILL_PAIRS=2
APEX_CAP_CHURN_CROSS_MARKET_WINDOW_SECONDS=900
APEX_CAP_CHURN_MIN_CROSS_MARKET_ROTATES=3
APEX_IDLE_ROTATE_REENTRY_COOLDOWN_SECONDS=900
# Acceptance gate — NAV/churn sanity (scripts/acceptance_gate.py)
ACCEPTANCE_MIN_NAV_PCT_OF_SESSION=0.85
ACCEPTANCE_MAX_CHURN_RATIO=0.75
ACCEPTANCE_MAX_SAME_TICK_CHURN=3
# Ticks with signals but no fills before trading_status=STALLED (18 ≈ 3 min)
APEX_TRADING_STALL_TICKS=18
# Consecutive stoppage ticks before DEGRADED/STOPPED status (10s tick → 6 = ~1 min)
APEX_STOPPAGE_TICKS=6
# Supervisor runs scripts/trader_health_audit.py on this interval (0 = disabled)
TRADER_HEALTH_AUDIT_SECONDS=1800
# Dashboard watchdog poll interval when using: ./scripts/ip4_supervisor.sh dashboard
DASHBOARD_WATCH_SECONDS=5
IP4_DASHBOARD_PORT=8501
PAPER_OBI_FAIR_WEIGHT=0.30
PAPER_OBI_FAIR_FLOOR=0.025
# Max fraction of NAV deployed across all open positions (0 = disabled, no cap)
# Max fraction of NAV deployed across all open positions (0 = disabled)
APEX_MAX_PORTFOLIO_PCT=0.50
APEX_STOP_LOSS_COOLDOWN_SECONDS=900
# Escalate cooldown 2× per repeat stop-out (capped); blocks cap-stall refill loops
APEX_STOP_LOSS_ESCALATION_MAX=4
APEX_STOP_LOSS_LOOKBACK_HOURS=24
APEX_STOP_LOSS_REENTRY_EDGE_MARGIN=0.01
APEX_LONGSHOT_MID_THRESHOLD=0.05
APEX_LONGSHOT_MIN_NET_EDGE=0.020
MOCK_OBI_CYCLE_SECONDS=30
MOCK_OBI_YES_COUNT=3
MOCK_OBI_NO_COUNT=1
MOCK_BOOK_DEPTH_BASE=2500

# --- V2 Signal Stack & Adaptive MTF ---
MTF_POLL_MS=250
MTF_TAU_FLOOR_MS=250
MTF_BETA=0.15
MTF_L1_FACTOR=0.5
MTF_TRADE_CONFIRM_MS=500
MTF_HARD_REJECT_RATIO=0.85
MTF_SPASM_SIGMA=3.0
MTF_SPASM_MULTIPLIER=2.0
BOOK_WATCHER_MAX_CONCURRENT=8
SIGNAL_DECAY_TAU_BOOK=5.0
SIGNAL_DECAY_TAU_FLOW=15.0
V2_EDGE_WEIGHT_MICROPRICE=0.25
V2_EDGE_WEIGHT_FLOW=0.25
V2_EDGE_WEIGHT_OBI=0.20
V2_EDGE_WEIGHT_LIQUIDITY=0.15
V2_EDGE_WEIGHT_RELIABILITY=0.10
V2_MIN_NET_EDGE_COST_MULT=2.0
V2_REGIME_CIRCUIT_BREAKER=true
REGIME_EPHEMERAL_THRESHOLD=0.7
REGIME_SPREAD_MULT=2.0
REGIME_Z_SPREAD_TRIP=2.5
REGIME_Z_DEPTH_TRIP=-2.0
REGIME_SCORE_TRIP=80
REGIME_SCORE_RECOVER=40
REGIME_RECOVER_TICKS=3
REGIME_Z_WINDOW_S=300
DMA_ENABLED=true
DMA_VOL_WINDOW_S=10
DMA_VOL_LOOKBACK_S=3600
DMA_VOL_PCTL=0.90
DMA_POLL_FAST_MS=50
DMA_POLL_SLOW_MS=250
DMA_DEBOUNCE_BASE_MS=200
DMA_DEBOUNCE_FLOOR_MS=50
DMA_DEBOUNCE_CEILING_MS=500
DMA_MIN_NOTIONAL_USD=50
DMA_SPREAD_TICK_WINDOW_MS=30000
APEX_CAP_TRIM_ENABLED=true
APEX_CAP_TRIM_FRACTION=0.50
APEX_CAP_TRIM_MIN_LEGS=2
APEX_CAP_TRIM_MIN_EDGE_MULT=2.0
JUDGE_MIN_IS_SORTINO=0.0
JUDGE_MIN_OOS_SORTINO=0.0
JUDGE_MAX_OOS_MDD=0.10
WALK_FORWARD_HIDDEN_FRACTION=0
SHADOW_PROMOTE_WINDOW_S=3600
SHADOW_PROMOTE_MIN_EDGE_DELTA=0.002
SHADOW_PROMOTE_TIMEOUT_MULT=2.0
KELLY_MIN_EDGE_SLOPE=-0.002
KELLY_MIN_SCALE=0.25
BACKTEST_SLIPPAGE_STRESS_MULT=2.0
BACKTEST_MAE_PENALTY=2.0
BACKTEST_FILL_PROB_FLOOR=0.15
BACKTEST_RESOLUTION_SPREAD_MULT=2.5
WALK_FORWARD_MIN_SAMPLES=30
WALK_FORWARD_MC_ITERATIONS=5

AUTORESEARCH_SLEEP_SECONDS=5
BACKTEST_MAX_ROWS=10000
# Synthetic resolutions for research logs only (RESEARCH_SCORE); champion SCORE is resolved-only
BACKTEST_MOCK_RESOLUTIONS=false
STRATEGY_SANDBOX_TIMEOUT=10
AUTORESEARCH_BACKTEST_TIMEOUT=60
# DeepSeek output budget for full active_strategy.py (raise if parse/truncation errors)
AUTORESEARCH_PROPOSAL_MAX_TOKENS=4096
# Set true to skip DeepSeek proposals (backtest-only loop for QA / paper Apex)
AUTORESEARCH_DRY_RUN=false
# Require at least N live markets with non-HOLD signals before KEEP
AUTORESEARCH_MIN_LIVE_SIGNALS=1
# Require at least N live signals passing Apex net-edge gate before KEEP
AUTORESEARCH_MIN_LIVE_FILL_ELIGIBLE=1
# Replay exhaust edge gate before KEEP
AUTORESEARCH_MIN_REPLAY_FILL_ELIGIBLE=5
AUTORESEARCH_MAX_REPLAY_EDGE_REJECT_RATE=0.5
AUTORESEARCH_REPLAY_SAMPLE_LIMIT=500
# Offline dev escape hatch when EDGE_MODEL_MOCKED=true
# IP4_ALLOW_MOCK_ORACLE=true
DEEPSEEK_V4_API=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
